# Copy to .env and adjust. Every value has a working default for local Compose.
VT_DATABASE_URL=postgresql://vessel:vessel@postgres:5432/vessel_tracking
VT_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
VT_KAFKA_TOPIC=ais.position-reports
VT_KAFKA_CONSUMER_GROUP=vessel-tracking
VT_FEED_PATH=ship_positions.json
# Messages per second the producer publishes; 0 publishes unthrottled.
VT_PRODUCER_RATE=200
