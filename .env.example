# Copy to .env and adjust. Compose loads .env automatically; every value below is
# already the default baked into docker-compose.yml, so an untouched checkout runs
# with no .env at all. Set a value here only to override it.

# Datastore credentials. Changing these means changing VT_DATABASE_URL to match.
VT_POSTGRES_USER=vessel
VT_POSTGRES_PASSWORD=vessel
VT_POSTGRES_DB=vessel_tracking

VT_DATABASE_URL=postgresql://vessel:vessel@postgres:5432/vessel_tracking
VT_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
VT_KAFKA_TOPIC=ais.position-reports
VT_KAFKA_CONSUMER_GROUP=vessel-tracking
VT_FEED_PATH=ship_positions.json

# Messages per second the producer publishes; 0 publishes unthrottled.
VT_PRODUCER_RATE=200
